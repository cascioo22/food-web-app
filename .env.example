# Food Webapp — Environment Example
# Copy this file to .env and fill in your local development settings

# FastAPI backend server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# LM Studio API endpoint for Qwen 3.5
LM_STUDIO_URL="http://192.168.12.117:1234/v1"
LM_STUDIO_API_KEY="local-dev-key"

# Optional: Browser test server (for running tests locally)
TEST_SERVER_PORT=8080

# Database path (SQLite, auto-created in backend folder)
DATABASE_PATH="./backend/food_webapp.db"
